# CivicFix Environment Configuration Template

# Core Server Settings
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=civicfix_super_secret_jwt_key_2026_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql+asyncpg://civicfix:civicfix_secret@localhost:5432/civicfix_db
SYNC_DATABASE_URL=postgresql://civicfix:civicfix_secret@localhost:5432/civicfix_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Object Storage (MinIO / S3)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=civicfix-reports
MINIO_SECURE=False

# AI Models & APIs
GEMINI_API_KEY=your_gemini_api_key_here
USE_MOCK_VISION=False

# Notification & Email (Resend API)
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=notifications@civicfix.gov

# CORS Config
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
