# CivicFix Environment Configuration Template

# Core Server Settings
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=civicfix_super_secret_jwt_key_2026_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Database (Supabase Transaction Pooler on port 6543, or local PostgreSQL + PostGIS)
# When using Supabase transaction pooler on port 6543 with asyncpg, statement_cache_size=0 is automatically enforced
DATABASE_URL=postgresql+asyncpg://postgres.tywmyjecafmpufdfxbus:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
SYNC_DATABASE_URL=postgresql://postgres.tywmyjecafmpufdfxbus:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Supabase Platform Credentials & Keys
SUPABASE_URL=https://tywmyjecafmpufdfxbus.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_dSoVH6SAgzYJ7dWeo_drOg_UCcqNmuw
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
SUPABASE_JWKS_URL=https://tywmyjecafmpufdfxbus.supabase.co/auth/v1/.well-known/jwks.json

# Asynchronous Pipeline Feature Flag & Limits
NEXT_PUBLIC_ASYNC_REPORTS=true
REPORTS_RATE_LIMIT_PER_MINUTE=10
PROOFS_SIGNED_URL_EXPIRY_SECONDS=900

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Object Storage (MinIO / S3)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=civicfix-reports
MINIO_SECURE=False

# AI Models & APIs
GEMINI_API_KEY=your_gemini_api_key_here
USE_MOCK_VISION=False

# Notification & Email (Resend API)
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=notifications@civicfix.gov

# CORS Config
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
